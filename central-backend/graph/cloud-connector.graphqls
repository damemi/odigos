# Cloud connector provider catalog. Mirrors connectors/spec.CloudConnectorSpec
# (the YAML-backed provider specs under connectors/spec/data). This is a static
# catalog served to the central UI to drive the Create Cloud Connector flow.

type CloudConnectorProvider {
  provider: String!
  displayName: String!
  connectorFields: [CloudConnectorField!]!
  auth: CloudConnectorAuth!
  features: [CloudConnectorFeature!]!
  # Declarative onboarding artifacts (e.g. the IAM policy preview). Provider-owned
  # templates the UI fills from the aggregated spec permissions; keeps the UI agnostic.
  setup: CloudConnectorSetup!
}

# Provider-defined onboarding artifacts, grouped so the schema can grow more setup
# metadata without a breaking change. Mirrors connectors/spec.Setup.
type CloudConnectorSetup {
  # Optional step-2 subtitle (provider-owned copy under "Setup credentials").
  subtitle: String!
  artifacts: [CloudConnectorSetupArtifact!]!
}

# One renderable onboarding artifact. The UI renders `template`, replacing the
# literal "{{permissions}}" placeholder with the aggregated permissions (each
# wrapped by `itemTemplate` and joined by `itemSeparator`) and scalar "{{name}}"
# tokens from live form values. `variant`/`variantLabel` drive the setup-method
# chooser for multi-artifact sections (e.g. create-role). `steps` is the ordered
# instruction list above the snippet. `format` is a syntax hint.
# Mirrors connectors/spec.SetupArtifact.
#
# `language` scopes an artifact in an `instrumentation:<type>` section to one
# runtime language, and is empty everywhere else. Without it those sections read
# as several artifacts claiming the same `variant`, since one Terraform snippet
# per language is the normal shape there — a connector serves only the language
# a given workload actually runs.
type CloudConnectorSetupArtifact {
  id: String!
  section: String!
  variant: String!
  variantLabel: String!
  language: String!
  title: String!
  description: String!
  steps: [String!]!
  # json | yaml | shell | text
  format: String!
  template: String!
  itemTemplate: String!
  itemSeparator: String!
}

type CloudConnectorAuth {
  permissions: [String!]!
  # Auth method id pre-selected in the create-connector UI (empty = UI default).
  defaultMethod: String!
  methods: [CloudConnectorAuthMethod!]!
}

type CloudConnectorAuthMethod {
  id: String!
  displayName: String!
  description: String!
  baseMethods: [String!]!
  fields: [CloudConnectorField!]!
}

type CloudConnectorFeature {
  # discovery | instrumentation | computePlatforms | collectorManagement | collectorDeployment | gateway
  #
  # A client aggregates permissions per access level from an allowlist of these keys, so a key it does
  # not know contributes nothing. The two collector keys are new and are in no access level yet: until
  # one lists them, a customer enabling a managed Collector is shown a policy that omits every
  # permission it needs.
  key: String!
  enabled: Boolean!
  displayName: String!
  description: String!
  permissions: [String!]!
  types: [CloudConnectorType!]!
}

type CloudConnectorType {
  name: String!
  displayName: String!
  description: String!
  permissions: [String!]!
  # How this type is acted on. The vocabulary is per domain:
  #   instrumentation      agent | sidecar | service
  #   collectorDeployment  fargate-service | container-app | cloud-run-service
  # Empty for the superset features (discovery, computePlatforms, collectorManagement).
  method: String!
  implemented: Boolean!
}

type CloudConnectorField {
  name: String!
  displayName: String!
  componentType: String!
  componentProps: JSON
  required: Boolean!
  secret: Boolean!
  tooltip: String!
  initialValue: String!
  # Whether the create-connector form renders this field up-front. False keeps a
  # rarely-needed optional credential (e.g. the AWS sessionToken, which only
  # temporary access keys use) behind a disclosure instead of on the common path.
  showInUi: Boolean!
  envVar: String!
}

extend type Query {
  cloudConnectorProviders: [CloudConnectorProvider!]!
}

# Test-connection: validate a prospective cloud connector's credentials and
# permissions in-memory (no Secret or connector pod is created). Mirrors
# connectors/testconnection.Input / Result and connectors/spec.Capability.

# Per-resource-type allow-list entry (mirrors spec.Capability), used to scope
# which discovery/instrumentation permissions the tester probes.
input CloudConnectorCapabilityInput {
  type: String!
  discovery: Boolean!
  instrumentation: Boolean!
  computePlatforms: Boolean!
}

# Per-Collector allow-list entry. Management observes and configures a Collector;
# deployment additionally lets Odigos install it.
input CloudConnectorCollectorCapabilityInput {
  type: String!
  management: Boolean!
  deployment: Boolean!
}

input TestCloudConnectorConnectionInput {
  # Provider key, e.g. "aws".
  provider: String!
  # In-memory credentials under test, keyed by the provider spec's auth field
  # names (e.g. "accessKeyId", "roleArn"). Never persisted or logged.
  credentials: JSON!
  # Account boundary id validated against the resolved identity ("" to skip).
  expectedAccountId: String!
  capabilities: [CloudConnectorCapabilityInput!]!
  collectors: [CloudConnectorCollectorCapabilityInput!]
}

type CloudConnectorTestCheck {
  name: String!
  displayName: String!
  passed: Boolean!
  message: String!
  remediation: String!
}

type CloudConnectorTestResult {
  success: Boolean!
  accountId: String!
  identity: String!
  checks: [CloudConnectorTestCheck!]!
}

extend type Mutation {
  # Runs read-only reachability/permission checks for a prospective connector.
  testCloudConnectorConnection(
    input: TestCloudConnectorConnectionInput!
  ): CloudConnectorTestResult!

  # Verifies the connection and, only if every check passes, creates the
  # credentials Secret + OdigosCloudConnector CR in the central cluster. When the
  # verification fails nothing is created and `created` is false with the checks.
  createCloudConnector(
    input: CreateCloudConnectorInput!
  ): CreateCloudConnectorResult!

  # Deletes an OdigosCloudConnector CR (and its credentials Secret) identified by
  # the connection id used in computePlatforms (the CR UID). Also clears any
  # Redis proxy metadata for that id so the connection disappears from the list.
  deleteCloudConnector(connectorId: String!): GeneralResult!
}

input CreateCloudConnectorInput {
  # Provider key, e.g. "aws".
  provider: String!
  # Human-friendly connector name (falls back to a derived name when empty).
  displayName: String!
  # In-memory credentials keyed by the provider spec's auth field names. Persisted
  # into the connector's credentials Secret only after verification passes.
  credentials: JSON!
  # Account boundary id; "" -> use the identity resolved during verification.
  expectedAccountId: String!
  capabilities: [CloudConnectorCapabilityInput!]!
  collectors: [CloudConnectorCollectorCapabilityInput!]
}

type CreateCloudConnectorResult {
  # Whether the connector was created (only true when verification passed).
  created: Boolean!
  # Name of the created OdigosCloudConnector CR ("" when not created).
  connectorId: String!
  # The verification result (checks/identity), same shape as the test mutation.
  test: CloudConnectorTestResult!
}
