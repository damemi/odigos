# GraphQL schema example
#
# https://gqlgen.com/getting-started/

scalar JSON
scalar Int64

enum PlatformType {
  k8s
  vm
}

enum Role {
  OWNER
  ADMIN
  MAINTAINER
  VIEWER
}

enum SignInStatus {
  SUCCESS
  PASSWORD_UPDATE_REQUIRED
}

enum AuthProviderId {
  AZURE
  OKTA
}



input SamlIdentityProviderInput {
  providerId: AuthProviderId!
  idpEntityId: String!
  singleSignOnServiceUrl: String!
  signingCertificate: String!
}

type SystemConfig {
  isInitialized: Boolean!
  version: String!
}

type ComputePlatform {
  id: String!
  name: String!
  odigosVersion: String!
  type: PlatformType!
  status: String!
  connectedAt: Int64
  lastSeenAt: Int64
  users: [User!]!
  teams: [Team!]!
}

input WriteComputePlatformInput {
  addUserIds: [String]
  removeUserIds: [String]
  addTeamIds: [String]
  removeTeamIds: [String]
}

input IdentityProviderInput {
  providerId: AuthProviderId!
  clientId: String!
  clientSecret: String!
  discoveryUrl: String!
  tenantId: String!
}

type SignInResult {
  idToken: String
  accessToken: String
  user: User
  status: SignInStatus!
}

type User {
  id: String!
  email: String!
  username: String!
  role: Role!
  needsPasswordChange: Boolean!
  teams: [Team!]!
  computePlatforms: [ComputePlatform!]!
}

input WriteUserInput {
  email: String
  password: String
  role: Role
  addTeamIds: [String]
  removeTeamIds: [String]
  addComputePlatformIds: [String]
  removeComputePlatformIds: [String]
}

type CreateUserResult {
  success: Boolean!
  userID: String!
  generatedPassword: String
}

type Team {
  id: String!
  name: String!
  description: String
  users: [User!]!
  computePlatforms: [ComputePlatform!]!
  createdAt: String!
  updatedAt: String!
}

input WriteTeamInput {
  name: String
  description: String
  addUserIds: [String]
  removeUserIds: [String]
  addComputePlatformIds: [String]
  removeComputePlatformIds: [String]
}

type GeneralResult {
  success: Boolean!
  error: String
}

type RemoteFetchResult {
  proxyID: String!
  success: Boolean!
  data: String
  error: String
}

type ServicesStatus {
  status: HealthStatus!
  message: String
}

enum HealthStatus {
  HEALTHY
  WARNING
  DOWN
}

type BackendHealthStatus {
  redisStatus: ServicesStatus!
  keycloakStatus: ServicesStatus!
  sseStatus: ServicesStatus!
}

type HealthQuery {
  backend: BackendHealthStatus!
}

type ApiToken {
  token: String!
  name: String!
  issuedAt: Int64!
  expiresAt: Int64!
}

type Query {
  remoteFetch(proxyID: String!, query: String!, variables: JSON!): String!
  remoteMultiFetch(
    proxyIDs: [String!]!
    query: String!
    variables: JSON!
  ): [RemoteFetchResult!]!
  systemConfig: SystemConfig!
  apiTokens: [ApiToken!]!
  signInUrl(providerId: AuthProviderId!): String
  signOutUrl(idToken: String): String
  computePlatforms: [ComputePlatform!]!
  users: [User!]!
  teams: [Team!]!
  health: HealthQuery!
}

type Mutation {
  # Identity Provider for OIDC
  ensureIdentityProvider(input: IdentityProviderInput!): GeneralResult!
  # Identity Provider for SAML
  ensureSamlIdentityProvider(input: SamlIdentityProviderInput!): GeneralResult!

  signIn(email: String, password: String, code: String): SignInResult!
  setInitialPassword(email: String!, password: String!): SignInResult!
  verifyToken(token: String!): GeneralResult!

  updateComputePlatform(
    id: String!
    input: WriteComputePlatformInput!
  ): GeneralResult!

  createUser(input: WriteUserInput!): CreateUserResult!
  updateUser(userID: String!, input: WriteUserInput!): GeneralResult!
  deleteUser(userID: String!): GeneralResult!

  createTeam(input: WriteTeamInput!): GeneralResult!
  updateTeam(teamID: String!, input: WriteTeamInput!): GeneralResult!
  deleteTeam(teamID: String!): GeneralResult!

  deleteProxyConnection(proxyID: String!): GeneralResult!
}
