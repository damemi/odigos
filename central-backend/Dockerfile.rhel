# 1️⃣ Build Stage: Compile Go Binary
FROM golang:1.23 AS builder

# Set working directory inside the container
WORKDIR /app

# Copy go.mod and go.sum to download dependencies
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the Go application
RUN go build -o central-backend .
RUN make licenses

# Use a minimal runtime image
FROM registry.access.redhat.com/ubi9/ubi-micro:latest
ARG VERSION
ARG RELEASE
ARG SUMMARY
ARG DESCRIPTION
LABEL "name"="Central Backend"
LABEL "vendor"="Odigos"
LABEL "maintainer"="Odigos"
LABEL "version"=$VERSION
LABEL "release"=$RELEASE
LABEL "summary"=$SUMMARY
LABEL "description"=$DESCRIPTION
                                                                                                                                                                                                                                                                                                                                                      

# Set working directory inside the container
WORKDIR /app

# Copy the compiled Go binary from the build stage
COPY --from=builder /app/central-backend .
COPY --from=builder /app/central-backend/licenses /licenses

# Expose the backend port
EXPOSE 8081
USER 65532:65532
# Run the backend service
CMD ["/app/central-backend"]