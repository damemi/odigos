  {
    "name": "java-lambda-adot",
    "displayName": "Java Lambda AWS ADOT",
    "language": "java",
    "isDefault": false,
    "execWrapper": "/opt/odigos-adot-java-handler",
    "artifact": "adot-java",
    "applicationSignals": false,
    "compatibleRuntimes": [
      "java11",
      "java17",
      "java21"
    ],
    "environment": {
      "OTEL_AWS_APPLICATION_SIGNALS_ENABLED": "false"
    },
    "bootstrapEnvironment": {
      "OTEL_AWS_APPLICATION_SIGNALS_RUNTIME_ENABLED": "false",
      "OTEL_AWS_LAMBDA_FAST_START": "false",
      "OTEL_PROPAGATORS": "tracecontext,baggage",
      "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://localhost:4318/v1/traces",
      "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "http://localhost:4318/v1/metrics",
      "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://localhost:4318/v1/logs",
      "OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED": "true",
      "OTEL_SDK_DISABLED": "false",
      "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
      "OTEL_AWS_APPLICATION_SIGNALS_EXPORTER_ENDPOINT": "http://localhost:4318/v1/metrics",
      "OTEL_AWS_OTLP_METRICS_ENDPOINT": "http://localhost:4318/v1/metrics",
      "OTEL_AWS_OTLP_LOGS_ENDPOINT": "http://localhost:4318/v1/logs"
    },
    "version": "2.31.0"
  },
