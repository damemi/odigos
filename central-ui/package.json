{
  "name": "central-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "check-peer-dependencies --runOnlyOnRootDependencies",
    "dev": "next dev --turbopack",
    "prebuild": "rm -rf out .next",
    "build": "cross-env NODE_ENV=production next build --turbopack",
    "build:analyze": "cross-env ANALYZE=true next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "cy:run": "cypress run --e2e -q",
    "cy:open": "cypress open --e2e -b electron"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@odigos/ui-kit": "0.0.256",
    "@odigos/vmagent-api-apollo-client": "0.12.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.0.8",
    "next": "15.5.14",
    "picomatch": "4.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "styled-components": "6.3.12",
    "ws": "8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.2.9",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/styled-components": "^5.1.36",
    "babel-plugin-styled-components": "^2.3.0",
    "check-peer-dependencies": "^4.3.4",
    "cross-env": "^10.1.0",
    "cypress": "^15.17.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.9",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "ajv": "^6.14.0",
    "diff": "^5.2.2",
    "flatted": "^3.4.2",
    "glob": "^10.5.0",
    "tar": "^7.5.7"
  }
}
