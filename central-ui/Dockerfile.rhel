
FROM node:22-alpine AS builder

# Set working directory inside the container
WORKDIR /app

# Copy go.mod and go.sum to download dependencies
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Install generate-license-file globally
RUN yarn global add generate-license-file

# Copy application source code
COPY . .

# Build the Next.js app
RUN yarn build

# Generate license file for all dependencies
RUN mkdir /app/licenses && \
    generate-license-file --input=./node_modules --output=./licenses/licenses.txt


# Use a minimal runtime image
FROM registry.access.redhat.com/ubi9/ubi-micro:latest
ARG VERSION
ARG RELEASE
ARG SUMMARY
ARG DESCRIPTION
LABEL "name"="Central UI"
LABEL "vendor"="Odigos"
LABEL "maintainer"="Odigos"
LABEL "version"=$VERSION
LABEL "release"=$RELEASE
LABEL "summary"=$SUMMARY
LABEL "description"=$DESCRIPTION
                                                                                                                                                                                                                                                                                                                                                      

# Set working directory inside the container
WORKDIR /app

# Copy only the built Next.js app
COPY --from=builder /app/package.json /app/yarn.lock ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/licenses /licenses


# Expose the frontend port
EXPOSE 3000
USER 65532:65532

# Start Next.js in production mode
CMD ["yarn", "start"]