# --- Builder Stage ---
    FROM node:22-bullseye AS builder


    WORKDIR /app
    
    # Copy dependency definitions and install
    COPY package.json yarn.lock ./
    RUN yarn install --frozen-lockfile
    
    # Add license generator tool as a dev dependency
    RUN yarn add -D license-checker
    
    # Copy all files and build
    COPY . .
    RUN yarn build

    # Debug: confirm dependencies exist
    RUN ls -la node_modules && ls node_modules | wc -l
    
    # Generate license file
    RUN mkdir -p /app/licenses && \
    npx license-checker --json > ./licenses/licenses.json && \
    echo "=== License file preview ===" && \
    head -n 20 ./licenses/licenses.json && \
    echo "=== End of license preview ==="

 
    
    # --- Runtime Stage ---
    FROM registry.access.redhat.com/ubi9/ubi-micro:latest
    
    ARG VERSION
    ARG RELEASE
    ARG SUMMARY
    ARG DESCRIPTION
    
    LABEL name="Central UI"
    LABEL vendor="Odigos"
    LABEL maintainer="Odigos"
    LABEL version=$VERSION
    LABEL release=$RELEASE
    LABEL summary=$SUMMARY
    LABEL description=$DESCRIPTION
    
    WORKDIR /app
    
    COPY --from=builder /app/package.json /app/yarn.lock ./
    COPY --from=builder /app/.next ./.next
    COPY --from=builder /app/public ./public
    COPY --from=builder /app/node_modules ./node_modules
    COPY --from=builder /app/licenses /licenses
    
    EXPOSE 3000
    USER 65532:65532
    
    CMD ["yarn", "start"]
    