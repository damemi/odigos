# Use the correct Go version
FROM golang:1.23 AS builder

# Set the working directory inside the container
WORKDIR /app

COPY central-proxy/ central-proxy

WORKDIR /app/central-proxy
# Copy and download dependencies 
RUN go mod download
# Build the binary
RUN go build -o central-proxy main.go
RUN make licenses

# Use a minimal runtime image
FROM registry.access.redhat.com/ubi9/ubi-micro:latest
ARG VERSION
ARG RELEASE
ARG SUMMARY
ARG DESCRIPTION
LABEL "name"="Central Proxy"
LABEL "vendor"="Odigos"
LABEL "maintainer"="Odigos"
LABEL "version"=$VERSION
LABEL "release"=$RELEASE
LABEL "summary"=$SUMMARY
LABEL "description"=$DESCRIPTION

# Set working directory
WORKDIR /root/

# Copy the built binary from the builder stage
COPY --from=builder /app/central-proxy .
COPY --from=builder /app/central-proxy/licenses /licenses

# Expose the necessary port
EXPOSE 8082
USER 65532:65532

# Run the application
CMD ["./central-proxy"]
